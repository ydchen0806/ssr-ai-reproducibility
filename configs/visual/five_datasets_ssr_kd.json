{
  "dataset": {
    "data_root": "./dataset",
    "name": "five_datasets"
  },
  "experiment_name": "r8_control_5ds_ssr",
  "method": {
    "A_exc": 1.2,
    "A_inh": 0.9,
    "biocs_targets": [
      "classifier"
    ],
    "buffer_size": 0,
    "label_smoothing": 0.05,
    "lambda_distill": 5.0,
    "lambda_feat": 0.0,
    "lambda_replay": 0.0,
    "lambda_spatial": 0.002,
    "lambda_spectral": 0.0,
    "name": "biocs_plus",
    "sigma_exc": 0.22,
    "sigma_inh": 0.6,
    "temperature": 3.0
  },
  "model": {
    "name": "resnet18"
  },
  "training": {
    "batch_size": 512,
    "epochs": 50,
    "grad_clip": 5.0,
    "lr": 0.05,
    "milestones": [
      20,
      25
    ],
    "momentum": 0.9,
    "num_workers": 4,
    "optimizer": "sgd",
    "save_final_model": true,
    "scheduler": "cosine",
    "use_amp": true,
    "warmup_epochs": 3,
    "weight_decay": 0.0
  }
}
