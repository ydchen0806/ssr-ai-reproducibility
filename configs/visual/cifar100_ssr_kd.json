{
  "dataset": {
    "data_root": "./dataset",
    "n_tasks": 10,
    "name": "split_cifar100"
  },
  "experiment_name": "r10_c100_phase_c_primary_rank1_gaussian_g3_l3_gaussian",
  "method": {
    "A_exc": 1.3,
    "A_inh": 1.15,
    "biocs_targets": [
      "classifier"
    ],
    "buffer_size": 0,
    "kernel_family": "gaussian",
    "label_smoothing": 0.0,
    "lambda_distill": 2.0,
    "lambda_feat": 0.0,
    "lambda_replay": 0.0,
    "lambda_spatial": 0.0025,
    "lambda_spectral": 0.0,
    "name": "biocs_plus",
    "sigma_exc": 0.28,
    "sigma_inh": 0.45,
    "temperature": 3.0
  },
  "model": {
    "name": "resnet18"
  },
  "training": {
    "batch_size": 512,
    "epochs": 50,
    "gamma": 0.1,
    "grad_clip": 5.0,
    "lr": 0.1,
    "milestones": [
      35,
      45
    ],
    "momentum": 0.9,
    "num_workers": 4,
    "optimizer": "sgd",
    "save_final_model": false,
    "scheduler": "multistep",
    "use_amp": true,
    "weight_decay": 0.0
  }
}
